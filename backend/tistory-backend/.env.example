# backend/tistory-backend/.env.example
# 복사해서 .env로 저장 후 값을 채우세요. (.env는 git에 올라가지 않습니다)

# docker-compose.yml의 db 서비스 기본값과 이미 일치합니다.
DB_NAME=tistory_clone
DB_USER=dev
DB_PASSWORD=devpass
DB_HOST=127.0.0.1
DB_PORT=5432

# 로그인 백엔드(FastAPI, backend/.env)의 JWT_SECRET_KEY와 반드시 동일해야
# 그쪽에서 발급한 토큰을 여기서 검증할 수 있습니다.
JWT_SECRET_KEY=dev-shared-jwt-secret-change-me
JWT_ALGORITHM=HS256

DJANGO_SECRET_KEY=dev-secret-key-change-me
DJANGO_DEBUG=True
