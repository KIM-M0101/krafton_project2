# frontend/.env.local.example
# 복사해서 frontend/.env.local 로 저장하세요. (.env.local은 git에 올라가지 않습니다)

# 로컬 개발용: 브라우저가 직접 EC2/localhost 백엔드를 호출
# 블로그 데이터 API (Django). 반드시 /api/v1 까지 포함
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001/api/v1
# 로그인 백엔드 (FastAPI)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Vercel 배포용: 아래 값들을 채우면 위 NEXT_PUBLIC_* 값을 /api/proxy/... 상대경로로 바꾸고,
# 이 값들로 next.config.ts의 rewrites가 EC2로 프록시함 (브라우저 fetch용)
# DJANGO_API_ORIGIN=http://<EC2_IP>:8001
# FASTAPI_BACKEND_ORIGIN=http://<EC2_IP>:8000
